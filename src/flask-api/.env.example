# AegisNIDS API Environment Configuration
FLASK_ENV=production
DEBUG=False
PORT=5000

# Optional API Security Key (leave blank for open demo mode)
AEGIS_API_KEY=

# Model Path (defaults to app/models/model.pkl)
MODEL_PATH=app/models/model.pkl

# Decision Boundaries
PREDICTION_THRESHOLD=0.035
IDLE_THRESHOLD_US=500000

# Security & Limits
MAX_CONTENT_LENGTH_BYTES=33554432
RATE_LIMIT_REQUESTS_PER_MIN=300
